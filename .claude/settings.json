{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=$(git rev-parse --show-toplevel 2>/dev/null) && bash \"$d/.claude/hooks/git-sync-pull.sh\"",
            "shell": "bash",
            "timeout": 60,
            "statusMessage": "同步遠端變更…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=$(git rev-parse --show-toplevel 2>/dev/null) && bash \"$d/.claude/hooks/git-sync-push.sh\"",
            "shell": "bash",
            "timeout": 90,
            "statusMessage": "自動 commit 並 push…"
          }
        ]
      }
    ]
  }
}
